{
  "expo": {
    "name": "Vanora",
    "slug": "vanora",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vanoraforlogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/vanora.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {},
    "android": {
      "package": "com.shipyard.vanora",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-image-picker"
    ],
    "scheme": "vanora",
    "extra": {
      "eas": {
        "projectId": "35661859-94d7-4c00-9f96-7fb5c4f412df"
      }
    },
    "owner": "tobikun11"
  }
}
